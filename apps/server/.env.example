PROXY_URL=
PROXY_SECRET=


# Webengage
WEBENGAGE_API_KEY=
# Bearer token WebEngage sends to POST /webhooks/webengage/sms (SSP API key)
WEBENGAGE_API_SECRET=
WEBENGAGE_LICENSE_CODE=
# e.g. https://api.webengage.com or regional host (ksa/in/us)
WEBENGAGE_HOST=
# Private SSP webhook URL from WebEngage dashboard (View Webhook URL) for delivery status notifications
WEBENGAGE_DSN_URL=
# Shared secret embedded in the Africa's Talking delivery-report callback URL:
# https://<api-host>/webhooks/africastalking/dlr?secret=<AT_DLR_SECRET>
AT_DLR_SECRET=

WEBENGAGE_PRIVATE_SSP_WEBHOOK_URL=      # from WebEngage after you register the Private SSP
WEBENGAGE_PRIVATE_SSP_AUTH_TOKEN=      # a secret you generate; WebEngage sends it back as a custom header

