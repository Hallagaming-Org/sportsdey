# Bonus Engine (loyalty, missions, and related callbacks)
# Admin Callback URL origin = SERVER_URL (e.g. https://staging-api.sportsdey.com).
# Engine POSTs to paths under that origin (see /gamification/callback/*).
# Store PEM keys in .dev.vars / Cloudflare secrets — never commit private keys.
BONUS_ENGINE_BASE_URL=https://bonus-engine-api.iglobalsoft.com/api
BONUS_ENGINE_CLIENT_ID=
BONUS_ENGINE_PROJECT_ID=
BONUS_ENGINE_CLIENT_SECRET=
BONUS_ENGINE_PRIVATE_KEY=
BONUS_ENGINE_CALLBACK_PUBLIC_KEY=
BONUS_ENGINE_CURRENCY=NGN
