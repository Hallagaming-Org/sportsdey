{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sportsdey-web",
	"main": "@tanstack/react-start/server-entry",
	"compatibility_date": "2026-01-27",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "dist/client"
	},
	"observability": {
		"enabled": true
	},
	"env": {
		"staging": {
			"name": "staging-web",
			"vars": {
				"ENV": "staging",
				"VITE_SERVER_URL": "https://staging-api.sportsdey.com",
				"VITE_API_URL": "https://staging-api.sportsdey.com",
				"VITE_PUBLIC_URL": "https://stagingweb.sportsdey.com",
				"VITE_DATABET_SPA_BOOTSTRAP_SCRIPT": "https://spa.int.databet.cloud/v2/f7078267/bootstrap.js",
				"VITE_DATABET_SPA_BASENAME": "/",
				"VITE_DATABET_DEFAULT_LOCALE": "en"
			},
			"routes": [
				{
					"pattern": "stagingweb.sportsdey.com",
					"custom_domain": true
				}
			]
		},
		"production": {
			"name": "prod-web",
			"vars": {
				"ENV": "production"
			},
			"routes": [
				{
					"pattern": "sportsdey.com",
					"custom_domain": true
				}
			]
		}
	}
}
