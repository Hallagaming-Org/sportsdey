/*.css
  Content-Type: text/css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Content-Type: application/javascript
  Cache-Control: public, max-age=31536000, immutable
/service-worker.js
  Content-Type: application/javascript
  Service-Worker-Allowed: /
  Cache-Control: no-cache
/*.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable
