# Local development (used by `pnpm dev`)
# Point at the Vite dev server; vite.config.ts proxies API routes to :3000.
VITE_SERVER_URL=http://localhost:3001
VITE_PUBLIC_URL=http://localhost:3001/
VITE_API_URL=http://localhost:3001

# Staging deploy uses `.env.staging` (`pnpm run deploy:staging`)
# Production deploy uses `.env.production` (`pnpm run deploy:production`)

# Data.Bet SPA v2 (staging: spa.int.databet.cloud, production: spa.databet.cloud)
VITE_DATABET_SPA_BOOTSTRAP_SCRIPT=https://spa.int.databet.cloud/v2/your-project/bootstrap.js
VITE_DATABET_SPA_BASENAME=/
VITE_DATABET_DEFAULT_LOCALE=en

# Openfort — required in `.env.local` (dev) and `.env.staging` (staging deploy).
# Without both publishable keys, the Crypto wallet section and Deposit → Crypto tab are hidden.
# VITE_OPENFORT_PUBLISHABLE_KEY=pk_test_...
# VITE_SHIELD_PUBLISHABLE_KEY=...
# Fee sponsorship policy must match the chain below (dashboard, outside this repo).
# VITE_OPENFORT_FEE_SPONSORSHIP_ID=pol_...

# Openfort chain (default: amoy testnet). Production ramp target is BEP20 + USDC.
# After Openfort dashboard is on BNB Smart Chain (Shield + gas sponsorship for chain 56):
#   VITE_OPENFORT_CHAIN=bsc
# ERC20 alternative: VITE_OPENFORT_CHAIN=ethereum
# Never pass the Amoy address to Quidax. Ramp stays disabled while chain is amoy.
# VITE_OPENFORT_CHAIN=amoy
# VITE_OPENFORT_RPC=https://...
# Legacy Amoy RPC alias (used only when chain is amoy):
# VITE_POLYGON_AMOY_RPC=https://polygon-amoy.gateway.tenderly.co
# Optional token overrides (defaults: USDC on the selected chain):
# VITE_OPENFORT_STABLECOIN_SYMBOL=USDC
# VITE_OPENFORT_STABLECOIN_ADDRESS=0x...
# VITE_OPENFORT_STABLECOIN_DECIMALS=18

# Quidax Ramp — public key only (sandbox until production chain + live keys).
# Widget buys USDC on the Openfort chain. Success must never credit the D1 Naira wallet.
# VITE_QUIDAX_RAMP_PUBLIC_KEY=pub_...
# Do not put QUIDAX_SECRET_KEY in web env. It belongs in apps/server `.dev.vars`.
# Optional override (default matches VITE_OPENFORT_STABLECOIN_SYMBOL):
# VITE_QUIDAX_RAMP_TO_CURRENCY=usdc

# Prediction Market SSO. Vite only exposes VITE_-prefixed vars to the browser.
# API origin, used for GET {base}/users/auth/sso?code=..&clientId=..
VITE_PREDICTION_MARKET_BACKEND_URL=<prediction-market-backend-url>
# The app the authenticated tab lands on.
VITE_PREDICTION_MARKET_URL=https://prediction.sportsdey.com
