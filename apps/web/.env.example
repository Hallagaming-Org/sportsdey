# Local development (used by `pnpm dev`)
# Point at the Vite dev server; vite.config.ts proxies API routes to :3000.
VITE_SERVER_URL=http://localhost:3001
VITE_PUBLIC_URL=http://localhost:3001/
VITE_API_URL=http://localhost:3001

# Staging deploy uses `.env.staging` (`pnpm run deploy:staging`)
# Production deploy uses `.env.production` (`pnpm run deploy:production`)

# Data.Bet SPA v2 (staging: spa.int.databet.cloud, production: spa.databet.cloud)
VITE_DATABET_SPA_BOOTSTRAP_SCRIPT=https://spa.int.databet.cloud/v2/your-project/bootstrap.js
VITE_DATABET_SPA_BASENAME=/
VITE_DATABET_DEFAULT_LOCALE=en

# Openfort (local test via `.env.local` only — do not put secrets in staging/prod yet)
# VITE_OPENFORT_PUBLISHABLE_KEY=pk_test_...
# VITE_SHIELD_PUBLISHABLE_KEY=...
# VITE_OPENFORT_FEE_SPONSORSHIP_ID=pol_...

