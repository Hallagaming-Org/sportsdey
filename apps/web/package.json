{
	"name": "web",
	"private": true,
	"type": "module",
	"scripts": {
		"clean": "node -e \"const fs=require('node:fs');for (const d of ['dist','.tanstack']) fs.rmSync(d,{recursive:true,force:true});\"",
		"build": "vite build",
		"build:staging": "pnpm run clean && vite build --mode staging",
		"build:production": "pnpm run clean && vite build --mode production",
		"serve": "vite preview",
		"dev": "vite dev --port=3001",
		"deploy:staging": "pnpm run build:staging && wrangler deploy dist/server/index.js --assets dist/client --env staging --config wrangler.jsonc",
		"deploy:production": "pnpm run build:production && wrangler deploy dist/server/index.js --assets dist/client --env production --config wrangler.jsonc",
		"cf-typegen": "wrangler types --env-interface Env"
	},
	"dependencies": {
		"@portabletext/react": "^6.0.2",
		"@radix-ui/react-accordion": "^1.2.12",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-slot": "^1.2.4",
		"@tailwindcss/vite": "^4.1.8",
		"@tanstack/react-form": "^1.23.5",
		"@tanstack/react-query": "^5.85.5",
		"@tanstack/react-router": "^1.132.31",
		"@tanstack/react-router-with-query": "^1.130.17",
		"@tanstack/react-start": "^1.132.31",
		"@tanstack/router-plugin": "^1.132.31",
		"@vercel/og": "^0.8.6",
		"better-auth": "^1.4.19",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"embla-carousel-autoplay": "^8.6.0",
		"embla-carousel-react": "^8.6.0",
		"framer-motion": "^12.40.0",
		"html-to-image": "^1.11.13",
		"iconsax-reactjs": "^0.0.8",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"lucide-react": "^0.525.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.4.2",
		"react": "19.1.0",
		"react-day-picker": "^9.11.1",
		"react-dom": "19.1.0",
		"sonner": "^2.0.3",
		"swiper": "^12.2.0",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.3",
		"tw-animate-css": "^1.2.5",
		"vite-tsconfig-paths": "^5.1.4",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.13.8",
		"@tanstack/react-query-devtools": "^5.85.5",
		"@tanstack/react-router-devtools": "^1.132.31",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/react": "^16.2.0",
		"@types/react": "~19.2.0",
		"@types/react-dom": "^19.0.4",
		"@vitejs/plugin-react": "^5.0.4",
		"baseline-browser-mapping": "^2.9.17",
		"jsdom": "^26.0.0",
		"typescript": "catalog:",
		"vite": "^7.0.2",
		"vite-plugin-svgr": "^4.5.0",
		"web-vitals": "^5.0.3",
		"wrangler": "^4.57.0"
	}
}
